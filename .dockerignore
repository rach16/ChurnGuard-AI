# Keep the build context small and deterministic.
.git
.venv
venv
__pycache__
*.pyc
node_modules
frontend/.next
frontend/node_modules
.pytest_cache
.ruff_cache
.mypy_cache

# Local state that must never leak into an image
.env
.aws
cache/*.pkl
warehouse/target
warehouse/logs
warehouse/*.duckdb

# Notebooks and docs are not needed at runtime
notebooks
docs
*.ipynb

# metrics/ is copied into the image for the committed evaluation baseline.
# Keep everything else in it out: per-run outputs are untracked and would make
# the image depend on whatever happens to be on the machine that built it, and
# the plots are not read by any endpoint.
metrics/*_results.csv
metrics/evaluation_comparison.csv
metrics/visualizations
