# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#   cp .env.example .env

# --- Required -------------------------------------------------------------------------
# Used for embeddings, the RAG answer chain, the multi-agent system, and RAGAS scoring.
OPENAI_API_KEY=

# --- Vector store ---------------------------------------------------------------------
# http://localhost:6333 when running Qdrant on the host, http://qdrant:6333 inside compose.
QDRANT_URL=http://localhost:6333
# A hosted cluster needs a key. Leave blank for a local container.
QDRANT_API_KEY=
# The index survives restarts on a hosted or on-disk store, so startup reuses it
# rather than re-embedding 771 documents -- 93s to 14s, measured 2026-09-02.
# Set true after changing the corpus; the check is a point count, not a checksum.
REINDEX_ON_START=false
COLLECTION_NAME=churnguard_knowledge

# --- Model provider -------------------------------------------------------------------
# Everything routes through src/core/llm.py, so switching provider is configuration
# rather than a code change. Defaults are openai / gpt-4o-mini.
#
#   LLM_PROVIDER=bedrock       LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
#   LLM_PROVIDER=anthropic     LLM_MODEL=claude-sonnet-4-5
#   LLM_PROVIDER=ollama        LLM_MODEL=llama3.1     (local; no data leaves the host)
#   LLM_PROVIDER=azure_openai  LLM_MODEL=<deployment name>
#
# Each needs its package: uv add langchain-aws | langchain-anthropic | langchain-ollama
# Changing EMBEDDING_MODEL invalidates the vector store -- re-index after switching.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Optional -------------------------------------------------------------------------
# Web search tool for the research agents. Left blank, Tavily is simply not used.
TAVILY_API_KEY=

# LangSmith tracing. Set TRACING_V2 to true only when you want runs recorded.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=customer-churn-rag

# --- API security ---------------------------------------------------------------------
# Comma-separated keys accepted in the X-API-Key header. LEAVE BLANK AND THE API
# SERVES UNAUTHENTICATED -- fine on localhost, never anywhere else. /health reports
# which mode it came up in, and the log says so loudly at startup.
#   API_KEYS=$(openssl rand -hex 32),$(openssl rand -hex 32)
API_KEYS=

# Requests per minute per caller (per key, or per client IP in open mode).
# Enforced PER PROCESS: behind two replicas the effective limit is twice this.
RATE_LIMIT_PER_MINUTE=60

# Cost controls for the LLM routes. LLM_MAX_TOKENS caps the completion; 0 removes
# the cap. MAX_QUESTION_CHARS bounds what can be sent in.
LLM_MAX_TOKENS=1024
MAX_QUESTION_CHARS=2000

# Spend ceiling for a PUBLIC deployment. Only /ask, /analyze-churn and
# /multi-agent-analyze cost money per request; everything else reads local data.
#   LLM_RATE_LIMIT_PER_HOUR  caps one visitor
#   LLM_DAILY_BUDGET         caps everyone together -- this is the real ceiling
# At roughly $0.001 a request, 200/day bounds the whole deployment to ~$0.20/day.
# Also set a hard monthly cap in the OpenAI dashboard; this cannot enforce that.
LLM_RATE_LIMIT_PER_HOUR=10
LLM_DAILY_BUDGET=200

# --- Log in with Salesforce (1.9, ADR-0012) -------------------------------------------
# All of these are set in the Render dashboard, never here. Leave DATABASE_URL blank
# and the API serves as before, reporting `connections` as off.
#
# The External Client App registered in the Salesforce org (consumer key and secret).
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Postgres for the connection, its sealed token, OAuth state and the audit log.
# Neon free tier here; RDS for a customer. Direct (non-pooled) URL, sslmode=require.
DATABASE_URL=
# The master key that wraps each connection's data key. One of:
#   CHURNGUARD_KMS_KEY_ID=alias/churnguard-staging-master   (AWS KMS, the production design;
#       needs AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION for an IAM user whose
#       only permissions are GenerateDataKey, Decrypt, ReEncrypt* and DescribeKey on that key)
#   CHURNGUARD_MASTER_KEY=<version>:<base64 32 bytes>[,<version>:<base64>...]   ($0 stand-in;
#       generate one with: uv run python -c "from integrations.crypto import new_local_master_key as k; print(k())")
# KMS wins when both are set.
CHURNGUARD_KMS_KEY_ID=
CHURNGUARD_MASTER_KEY=
AWS_REGION=us-west-2
# Where Salesforce sends the popup back: this site's origin, no path. The callback
# URL registered on the External Client App is <origin>/api/integrations/salesforce/callback.
PUBLIC_SITE_ORIGIN=
# Operator actions (connect, test, disconnect) require this in X-Operator-Key. The
# browser never holds it: the site's /ops/* route attaches it server-side from its
# own copy. Unset means those actions answer 404. The stand-in until login (2.6).
#   OPERATOR_KEY=$(openssl rand -hex 32)
OPERATOR_KEY=
# Optional. Pins the org before the first connect; after it, the connected org is
# the pin whether or not this is set.
SALESFORCE_ORG_ID=
# The schedule (1.11). A connection is due for a sync when its last success is
# older than this many hours; a scheduled run is deferred while the org has less
# than this fraction of its daily API allowance left. The schedule itself is
# .github/workflows/sync.yml calling POST /connections/sync-due, plus a check
# on every start, because the free tier sleeps and a timer in the process would
# not fire. Defaults shown.
SYNC_INTERVAL_HOURS=24
SYNC_API_RESERVE=0.20
# Operator sign-in (2.6, ADR-0013). All four, or sign-in is off and /auth/me says
# why. One user pool per environment; the app client is confidential (has a
# secret) with the authorization-code grant, scope openid only, and the
# callback <PUBLIC_SITE_ORIGIN>/api/auth/callback. COGNITO_DOMAIN is the managed
# login domain, e.g. churnguard-staging.auth.us-west-2.amazoncognito.com.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=

# --- Runtime --------------------------------------------------------------------------
# Which customer to serve: data (synthetic) or data/salesforce. The warehouse and
# survival model files follow it (src/core/datasource.py). DATA_FOLDER still works.
CHURNGUARD_DATA_DIR=data
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Where the frontend's /api/* rewrite forwards to. Server-side only: it has no
# NEXT_PUBLIC_ prefix, so it never reaches the browser. Resolved at BUILD time
# and frozen into the route manifest -- changing it needs a rebuild, not a
# restart. Unset means http://localhost:8000, which is what you want locally.
BACKEND_ORIGIN=http://localhost:8000
